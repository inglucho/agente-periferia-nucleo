# Variables requeridas, sin valores (copiar a .env y completar). Nunca subir .env al repositorio.

# Proveedor y modelo de lenguaje
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Clave del proveedor: solo para el chat. demo.ts y los tests no la usan.
LLM_API_KEY=

# Límites de costo y robustez
LLM_TIMEOUT_MS=120000
MAX_ITERACIONES=25
MAX_TOKENS_SESION=500000

PORT=3000
